## Lib module pattern

```ts
export type ToolResult = { output: string; error: string };

export function processInput(input: string): ToolResult {
    try {
        // ...
        return { output: result, error: '' };
    } catch (exception) {
        return { output: '', error: exception instanceof Error ? exception.message : 'Unknown error' };
    }
}
```

Return `{ output, error }` instead of throwing — pages handle display.
